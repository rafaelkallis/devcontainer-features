{
    "name": "Codex CLI Mounts",
    "id": "codex-mounts",
    "version": "1.0.1",
    "description": "Mounts host Codex CLI configuration directory into the dev container",
    "options": {},
    "postCreateCommand": "/usr/local/share/devcontainer-features/codex-mounts/post-create.sh",
    "mounts": [
        {
            "type": "bind",
            "source": "${localEnv:HOME}/.codex",
            "target": "/mnt/.codex"
        }
    ]
}
