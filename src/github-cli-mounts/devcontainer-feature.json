{
    "name": "GitHub CLI Mounts",
    "id": "github-cli-mounts",
    "version": "1.0.0",
    "description": "Mounts host GitHub CLI configuration directory into the dev container",
    "options": {},
    "mounts": [
        {
            "type": "bind",
            "source": "${localEnv:HOME}/.config/gh",
            "target": "/mnt/.config/gh"
        }
    ]
}
